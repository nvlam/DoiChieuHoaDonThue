<Window x:Class="DoiChieuHoaDonThue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đối chiếu hóa đơn thuế"
        MinWidth="900"
        MinHeight="500">

    <Grid Margin="10">
        <!-- ===== Layout rows ===== -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- File selectors -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Result label -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- ===== Layout columns ===== -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Row 0: File Cổng Thuế ===== -->
        <Label Grid.Row="0" Grid.Column="1"
               Content="Excel từ Cổng Thuế:"
               FontWeight="Bold"
               VerticalAlignment="Center"/>

        <TextBox Grid.Row="0" Grid.Column="2"
                 x:Name="txtTepCongThue"
                 IsReadOnly="True"
                 Margin="0,0,5,0"/>

        <Button Grid.Row="0" Grid.Column="0"
                x:Name="btnBrowseThue"
                Content="Chọn tệp"
                Click="btnBrowseThue_Click"/>

        <!-- ===== Row 1: File MISA ===== -->
        <Label Grid.Row="1" Grid.Column="1"
               Content="Excel từ phần mềm Kế toán:"
               FontWeight="Bold"
               VerticalAlignment="Center"
               Margin="0,5,0,0"/>

        <TextBox Grid.Row="1" Grid.Column="2"
                 x:Name="txtTepMisa"
                 IsReadOnly="True"
                 Margin="0,5,5,0"/>

        <Button Grid.Row="1" Grid.Column="0"
                x:Name="btnBrowseMisa"
                Content="Chọn tệp"
                Margin="0,5,0,0"
                Click="btnBrowseMisa_Click"/>

        <!-- ===== Row 2: Action buttons ===== -->
        <StackPanel Grid.Row="2" Grid.Column="2"
             Orientation="Vertical"
             Margin="0,10,0,10">

            <StackPanel
                    Orientation="Horizontal"
                    Margin="0,10,0,10">

                <Button x:Name="btnCompare"
                    Content="Đối chiếu"
                    Width="120"
                    Margin="0,0,10,0"
                    Click="btnCompare_Click"/>

                 <Button x:Name="btnExport"
                    Content="Xuất Excel kết quả"
                    Width="200"
                    Click="btnExport_Click"/>
            </StackPanel>

        <Label 
               x:Name="lblKetQua"
               Content="Kết quả:"
               FontWeight="Bold"
               VerticalAlignment="Top"
               Margin="0,10,0,10" />
        </StackPanel>
        

        <!-- ===== Row 3: DataGrid ===== -->
        <DataGrid Grid.Row="3" Grid.ColumnSpan="3"
                  x:Name="DataGridKetQua"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">

            <!-- ===== Row coloring ===== -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>

                        <DataTrigger Binding="{Binding LoaiLoi}" Value="MissingMISA">
                            <Setter Property="Background" Value="#FFCDD2"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding LoaiLoi}" Value="MissingCT">
                            <Setter Property="Background" Value="#BBDEFB"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding LoaiLoi}" Value="AmountDiff">
                            <Setter Property="Background" Value="#FFF9C4"/>
                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <!-- ===== Columns ===== -->
            <DataGrid.Columns>

                <DataGridTextColumn Header="Số hóa đơn"
                                    Binding="{Binding SoHoaDon}"
                                    Width="100"/>

                <DataGridTextColumn Header="Ngày hóa đơn"
                                    Binding="{Binding NgayHoaDonHienThi}"
                                    Width="130"/>

                <DataGridTextColumn Header="Tên khách hàng"
                                    Binding="{Binding TenKhachHangHienThi}"
                                    Width="200"/>

                <DataGridTextColumn Header="Tiền Cổng Thuế"
                                    Binding="{Binding TongTienCongThue}"
                                    Width="140"/>

                <DataGridTextColumn Header="Tiền MISA"
                                    Binding="{Binding DoanhThuMisa}"
                                    Width="140"/>

                <DataGridTextColumn Header="Ghi chú"
                                    Binding="{Binding GhiChu}"
                                    Width="*"/>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
